# Copy this file to .env and fill in real values. .env is gitignored so
# secrets never leave your machine. The PUBLIC_ prefix exposes the var to
# client-side code (the contact form needs the endpoint at runtime).

# Formspree endpoint for the contact form. Get yours at https://formspree.io,
# create a new form, copy the action URL (looks like https://formspree.io/f/abc123).
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
