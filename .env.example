# Copy this file to .env and fill in real values. .env is gitignored so
# nothing here leaves your machine. The PUBLIC_ prefix is what exposes the
# value to the built page; without it the variable is server-only and the
# form would ship with the placeholder endpoint.

# Formspree endpoint for the contact form. Create a form at
# https://formspree.io and copy its action URL (https://formspree.io/f/abc123).
#
# For production, set the same value as a repo secret named
# PUBLIC_FORMSPREE_ENDPOINT so the GitHub Actions build picks it up.
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
