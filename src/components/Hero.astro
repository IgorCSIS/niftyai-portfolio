---
/**
 * Hero.
 *
 * Asymmetric: headline and CTAs take seven columns, the audit panel takes
 * five and sits lower, so the eye travels diagonally instead of landing on
 * a centered block. On mobile the panel stacks under the CTAs.
 *
 * The signature micro-interaction lives here: a cyan rule draws itself
 * under the accent phrase on load. It runs once, takes under a second, and
 * is the only thing on the page that animates without being scrolled to.
 * Under prefers-reduced-motion the rule is simply already drawn.
 *
 * Because the header is fixed and transparent over this section, the
 * top padding has to clear it manually.
 */
import { hero } from "../data/site";
---

<section
  id="hero"
  class="relative overflow-hidden pb-20 pt-[calc(var(--header-h)+3.5rem)] sm:pb-24 sm:pt-[calc(var(--header-h)+5rem)] lg:pb-32 lg:pt-[calc(var(--header-h)+7rem)]"
>
  <!-- Fine grid, masked to fade before it reaches the edges. -->
  <div class="grid-field" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 sm:px-6">
    <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <p class="label animate-fade-up">{hero.eyebrow}</p>

        <h1 class="t-display mt-7 text-mist-50">
          <span class="block animate-fade-up [animation-delay:80ms]">{hero.headlinePre}</span>
          <!-- The accent phrase carries the drawn rule. inline-block so the
               pseudo-element measures the phrase, not the whole line. -->
          <span
            class="relative mt-1 inline-block animate-fade-up text-cyan-300 [animation-delay:160ms]"
            data-hero-accent
          >
            {hero.headlineAccent}
          </span>
        </h1>

        <p class="t-lead mt-7 max-w-xl animate-fade-up [animation-delay:240ms]">
          {hero.sub}
        </p>

        <div class="mt-9 flex animate-fade-up flex-col gap-3 sm:flex-row sm:items-center [animation-delay:320ms]">
          <a href={hero.primaryCta.href} class="btn btn-primary">
            {hero.primaryCta.label}
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </a>
          <a href={hero.secondaryCta.href} class="btn btn-ghost">
            {hero.secondaryCta.label}
          </a>
        </div>
      </div>

      <!-- Audit panel. Offset down on large screens to break the grid line
           across the top of the section. -->
      <div class="animate-fade-up lg:col-span-5 lg:pt-8 [animation-delay:400ms]">
        <div class="surface overflow-hidden rounded-panel p-7 sm:p-8">
          <!-- Single soft bloom in the corner. One light source, not four. -->
          <div
            class="pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full bg-cyan-400/20 blur-3xl"
            aria-hidden="true"
          >
          </div>

          <p class="label">{hero.panel.label}</p>
          <h2 class="t-h3 mt-4 text-mist-50">{hero.panel.title}</h2>

          <ul class="mt-6 space-y-3.5">
            {
              hero.panel.lines.map((line) => (
                <li class="flex items-start gap-3 text-[0.95rem] leading-snug text-mist-200">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 shrink-0 text-cyan-400"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span>{line}</span>
                </li>
              ))
            }
          </ul>

          <hr class="rule my-6" />

          <p class="text-sm text-mist-300">{hero.panel.footnote}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The drawn rule under the accent phrase. Sits 0.1em under the baseline
     box, scales from the left, and is masked into a soft taper at the
     right end so it reads as drawn rather than as a border. */
  [data-hero-accent]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.06em;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(
      90deg,
      theme("colors.cyan.400"),
      theme("colors.cyan.300") 62%,
      rgba(165, 243, 252, 0)
    );
    transform: scaleX(0);
    transform-origin: left center;
    animation: hero-rule 1s cubic-bezier(0.22, 1, 0.36, 1) 0.55s forwards;
  }

  @keyframes hero-rule {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-accent]::after {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>
