---
/**
 * Sticky mobile CTA bar.
 *
 * Small screens lose the header button once the menu collapses, so the
 * primary action rides along the bottom instead. It only appears after
 * the hero has scrolled away (handled in src/scripts/nav.ts) so it does
 * not cover the hero's own buttons, and it hides again over the contact
 * section where it would be pointing at a form already on screen.
 *
 * translate-y-full is the resting state; the script adds .is-visible.
 * Bottom padding respects the iOS home indicator via safe-area-inset.
 */
---

<div
  id="mobile-cta"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-navy-700 bg-navy-900/92 px-4 pb-[calc(0.75rem+env(safe-area-inset-bottom))] pt-3 backdrop-blur-xl transition-transform duration-500 sm:hidden"
>
  <a href="#contact" class="btn btn-primary w-full">Book the $500 audit</a>
</div>

<style>
  #mobile-cta.is-visible {
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-cta {
      transition: none;
    }
  }
</style>
