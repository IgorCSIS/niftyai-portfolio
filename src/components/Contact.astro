---
/**
 * Contact section.
 *
 * Form on the left, direct contact info on the right. The form posts to
 * Formspree, which gives you a free tier for static sites that handles
 * spam filtering and emails the responses to you. Sign up at
 * https://formspree.io, grab your endpoint, drop it in .env, done.
 *
 * Until the endpoint is set we point the form to a placeholder so the UI
 * works locally without throwing errors. The form's action falls back to
 * the placeholder if the env var is missing.
 *
 * Why Formspree over rolling our own backend: this is a static GitHub
 * Pages site. Any "real" backend would need separate hosting and we'd be
 * paying for a service to do one job. Formspree's free tier is 50 messages
 * a month, plenty for a portfolio.
 */

// Astro exposes Vite env vars under import.meta.env. The PUBLIC_ prefix
// makes them available to client-rendered components; without it they're
// server-only. We need this in the rendered HTML, so PUBLIC_ it is.
const formspreeEndpoint =
  import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? "https://formspree.io/f/your-form-id";
---

<section id="contact" class="relative py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-12 lg:grid-cols-[3fr_2fr] lg:gap-16">
      <div>
        <span class="reveal section-label">Let's talk</span>
        <h2
          class="reveal mt-4 font-display text-4xl font-bold leading-tight tracking-tight md:text-5xl"
          data-reveal-delay="100"
        >
          Tell me what you're building.
        </h2>
        <p class="reveal mt-5 max-w-xl text-lg text-paper-200" data-reveal-delay="200">
          A short note is enough to get started. I reply within one business
          day. If your project's a fit, the next step is a 30-minute call to
          scope it and lock a price.
        </p>

        <form
          action={formspreeEndpoint}
          method="POST"
          class="reveal mt-10 space-y-5"
          data-reveal-delay="300"
        >
          {/* Honeypot field. Bots fill every input they see; humans don't
              see this one because it's visually hidden. Formspree drops
              submissions that include a non-empty "_gotcha" field. */}
          <input
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            class="hidden"
            aria-hidden="true"
          />

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-paper-300">
                Your name
              </span>
              <input
                type="text"
                name="name"
                required
                class="w-full rounded-lg border border-ink-600 bg-ink-800/60 px-4 py-3 text-paper-100 placeholder:text-paper-300 transition-colors focus:border-electric-500 focus:outline-none focus:ring-1 focus:ring-electric-500"
                placeholder="Igor Lima"
              />
            </label>
            <label class="block">
              <span class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-paper-300">
                Email
              </span>
              <input
                type="email"
                name="email"
                required
                class="w-full rounded-lg border border-ink-600 bg-ink-800/60 px-4 py-3 text-paper-100 placeholder:text-paper-300 transition-colors focus:border-electric-500 focus:outline-none focus:ring-1 focus:ring-electric-500"
                placeholder="you@company.com"
              />
            </label>
          </div>

          <label class="block">
            <span class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-paper-300">
              Project type
            </span>
            <select
              name="projectType"
              class="w-full rounded-lg border border-ink-600 bg-ink-800/60 px-4 py-3 text-paper-100 transition-colors focus:border-electric-500 focus:outline-none focus:ring-1 focus:ring-electric-500"
            >
              <option>Custom AI Agent</option>
              <option>Workflow Automation</option>
              <option>AI-Powered Web App</option>
              <option>Data + LLM Pipeline</option>
              <option>Prototype in a Week</option>
              <option>Consult / Pair</option>
              <option>Other / not sure yet</option>
            </select>
          </label>

          <label class="block">
            <span class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-paper-300">
              What are you trying to build?
            </span>
            <textarea
              name="message"
              required
              rows="5"
              class="w-full resize-y rounded-lg border border-ink-600 bg-ink-800/60 px-4 py-3 text-paper-100 placeholder:text-paper-300 transition-colors focus:border-electric-500 focus:outline-none focus:ring-1 focus:ring-electric-500"
              placeholder="One paragraph is fine. Stack, deadlines, budget if you have one."
            ></textarea>
          </label>

          <button
            type="submit"
            class="btn-primary inline-flex items-center gap-2 rounded-full px-7 py-3.5 font-semibold text-ink-900 shadow-lg shadow-electric-500/20"
          >
            Send the brief
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </button>

          <p class="text-xs text-paper-300">
            Submissions are handled by Formspree. I never share your email or
            details with anyone.
          </p>
        </form>
      </div>

      <!-- Right column: direct contact options for people who don't want
           to use the form. The "office hours" line gives a sense of when
           you're reachable without committing to instant replies. -->
      <aside class="space-y-8 lg:pt-20">
        <div class="reveal rounded-2xl border border-ink-600 bg-ink-800/40 p-6" data-reveal-delay="100">
          <h3 class="font-display text-lg font-semibold text-paper-100">
            What happens next
          </h3>
          <ol class="mt-3 space-y-2 text-sm text-paper-200">
            <li class="flex items-start gap-3">
              <span class="mt-0.5 font-mono text-xs text-electric-400">01</span>
              <span>You send the brief. I read it within one business day.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 font-mono text-xs text-electric-400">02</span>
              <span>We hop on a 30-minute call to scope it tight.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 font-mono text-xs text-electric-400">03</span>
              <span>I send a fixed quote and timeline. You say go.</span>
            </li>
          </ol>
        </div>

        <div class="reveal rounded-2xl border border-ink-600 bg-ink-800/40 p-6" data-reveal-delay="200">
          <h3 class="font-display text-lg font-semibold text-paper-100">
            Office hours
          </h3>
          <p class="mt-2 text-sm text-paper-200">
            Monday to Friday, 9 to 6 Pacific. Based in San Diego, California.
            Replies within one business day, usually faster.
          </p>
        </div>

        <div class="reveal rounded-2xl border border-ink-600 bg-ink-800/40 p-6" data-reveal-delay="300">
          <h3 class="font-display text-lg font-semibold text-paper-100">
            Working with you
          </h3>
          <ul class="mt-3 space-y-2 text-sm text-paper-200">
            <li class="flex items-start gap-2">
              <span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full bg-electric-500"></span>
              Fixed scope, fixed price after a 30-min call
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full bg-electric-500"></span>
              Weekly demos, daily updates if you want them
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full bg-electric-500"></span>
              You own the code. Always.
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
