---
/**
 * Contact.
 *
 * The form posts to Formspree, same as before, and still works as a plain
 * HTML form submission if JavaScript never loads: action and method are
 * real, the fields are required, and Formspree renders its own thank-you
 * page. src/scripts/form.ts upgrades it to an inline fetch submit with
 * field-level validation when JS is available.
 *
 * Set PUBLIC_FORMSPREE_ENDPOINT in .env (and as a repo secret for the
 * Actions build) to point it at the real form. Without it the action
 * falls back to a placeholder so local development does not throw.
 */
import { contact, site } from "../data/site";

const formspreeEndpoint =
  import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? "https://formspree.io/f/your-form-id";
---

<section id="contact" class="relative py-section lg:py-section-lg">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="reveal label">{contact.label}</p>
        <h2 class="reveal t-h2 mt-5 text-mist-50" data-reveal-delay="60">{contact.title}</h2>
        <p class="reveal t-lead mt-5 max-w-xl" data-reveal-delay="120">{contact.intro}</p>

        <form
          id="contact-form"
          action={formspreeEndpoint}
          method="POST"
          novalidate
          class="reveal mt-10 space-y-5"
          data-reveal-delay="180"
        >
          <!-- Honeypot. Bots fill every field they can see; this one is
               hidden from humans and Formspree drops any submission that
               arrives with it filled in. -->
          <input
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            class="hidden"
            aria-hidden="true"
          />

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="field-label" for="cf-name">Your name</label>
              <input
                id="cf-name"
                class="field"
                type="text"
                name="name"
                required
                autocomplete="name"
                placeholder="First and last"
                aria-describedby="cf-name-error"
              />
              <p id="cf-name-error" class="mt-1.5 hidden text-xs text-red-400" data-error-for="name"></p>
            </div>

            <div>
              <label class="field-label" for="cf-business">Business</label>
              <input
                id="cf-business"
                class="field"
                type="text"
                name="business"
                autocomplete="organization"
                placeholder="Company name, optional"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="field-label" for="cf-email">Email</label>
              <input
                id="cf-email"
                class="field"
                type="email"
                name="email"
                required
                autocomplete="email"
                inputmode="email"
                placeholder="you@company.com"
                aria-describedby="cf-email-error"
              />
              <p id="cf-email-error" class="mt-1.5 hidden text-xs text-red-400" data-error-for="email"></p>
            </div>

            <div>
              <label class="field-label" for="cf-need">What do you need</label>
              <select id="cf-need" class="field" name="need">
                {contact.needs.map((need) => <option value={need}>{need}</option>)}
              </select>
            </div>
          </div>

          <div>
            <label class="field-label" for="cf-message">What is eating the most time right now</label>
            <textarea
              id="cf-message"
              class="field resize-y"
              name="message"
              required
              rows="5"
              placeholder="One paragraph is plenty. What the task is, who does it, roughly how often."
              aria-describedby="cf-message-error"></textarea>
            <p id="cf-message-error" class="mt-1.5 hidden text-xs text-red-400" data-error-for="message"></p>
          </div>

          <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
            <button type="submit" class="btn btn-primary w-full sm:w-auto" data-submit>
              <span data-submit-label>Send it over</span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </button>
            <p class="text-xs leading-relaxed text-mist-300">
              Handled by Formspree. I never share your details with anyone.
            </p>
          </div>

          {
            site.email && (
              <p class="text-sm text-mist-300">
                Form giving you trouble? Email me straight at{" "}
                <a href={`mailto:${site.email}`} class="link-underline font-medium">{site.email}</a>.
              </p>
            )
          }

          <!-- Status line. aria-live so screen readers announce the result
               of a submit that never reloads the page. -->
          <p
            id="form-status"
            role="status"
            aria-live="polite"
            class="hidden rounded-card border border-navy-600 bg-navy-950/60 px-4 py-3 text-sm"
          >
          </p>
        </form>
      </div>

      <aside class="space-y-4 lg:col-span-5 lg:pt-16">
        <div class="reveal surface p-6 sm:p-7" data-reveal-delay="80">
          <h3 class="t-h3 text-mist-50">What happens next</h3>
          <ol class="mt-5 space-y-4">
            {
              contact.steps.map((step) => (
                <li class="flex items-start gap-3.5">
                  <span class="mt-0.5 font-mono text-xs text-cyan-300">{step.n}</span>
                  <span class="text-sm leading-relaxed text-mist-200">{step.text}</span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="reveal surface p-6 sm:p-7" data-reveal-delay="140">
          <h3 class="t-h3 text-mist-50">How I work</h3>
          <ul class="mt-5 space-y-3">
            {
              contact.promises.map((promise) => (
                <li class="flex items-start gap-3 text-sm text-mist-200">
                  <span class="mt-[0.45rem] h-1 w-1 shrink-0 rounded-full bg-cyan-400" aria-hidden="true" />
                  <span>{promise}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal surface p-6 sm:p-7" data-reveal-delay="200">
          <h3 class="t-h3 text-mist-50">Elsewhere</h3>
          <p class="mt-3 text-sm text-mist-200">
            Monday to Friday, Pacific time. Based in {site.city}, {site.region}.
          </p>

          <!-- Primary links get a full row each: label, one line of context,
               and an arrow. Big enough to read as the obvious next click. -->
          <ul class="mt-5 space-y-2">
            {
              contact.elsewhere
                .filter((link) => link.primary)
                .map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="elsewhere-row group flex items-center justify-between gap-4 rounded-card border border-navy-600 bg-navy-950/50 px-4 py-3.5"
                    >
                      <span class="min-w-0">
                        <span class="block text-sm font-semibold text-mist-50">{link.label}</span>
                        <span class="mt-0.5 block truncate text-xs text-mist-300">{link.note}</span>
                      </span>
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="shrink-0 text-cyan-300 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                        aria-hidden="true"
                      >
                        <path d="M7 17 17 7M9 7h8v8" />
                      </svg>
                    </a>
                  </li>
                ))
            }
          </ul>

          <!-- Secondary links and the email sit together on one quiet row. -->
          <div class="mt-4 flex flex-wrap items-center gap-3">
            {
              contact.elsewhere
                .filter((link) => !link.primary)
                .map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-ghost !min-h-0 !px-4 !py-2 text-sm"
                  >
                    {link.label}
                  </a>
                ))
            }
            {
              site.email && (
                <a href={`mailto:${site.email}`} class="btn btn-ghost !min-h-0 !px-4 !py-2 text-sm">
                  Email
                </a>
              )
            }
          </div>

          {
            site.email && (
              <p class="mt-4 border-t border-navy-700 pt-4 font-mono text-xs text-mist-300">
                <a href={`mailto:${site.email}`} class="link-underline break-all">
                  {site.email}
                </a>
              </p>
            )
          }
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  /* Prominent link rows in the Elsewhere card. The border warms to cyan and
     the row lifts a little, matching the card hover language used elsewhere
     on the page without borrowing the full .surface-hover shadow, which is
     too heavy for something nested inside another card. */
  .elsewhere-row {
    transition:
      border-color 0.35s var(--ease-soft),
      background-color 0.35s var(--ease-soft),
      transform 0.35s var(--ease-out);
  }

  @media (hover: hover) {
    .elsewhere-row:hover {
      border-color: theme("colors.cyan.400");
      background-color: rgba(34, 211, 238, 0.07);
      transform: translateY(-2px);
    }
  }
</style>
