---
/**
 * Portfolio / Work section.
 *
 * Card grid with case-study spine on each entry. The spine (Problem,
 * Approach, Result) is the difference between a project that reads like
 * "look what I made" and one that reads like "I think about systems."
 * Hiring managers and prospects skim cards; the ones who actually engage
 * expand the details element to see how I made the call.
 *
 * Each project has an optional `link` (live demo), `repo` (source), and
 * a `buildNotes` object that powers the expandable case-study panel.
 * Cards render the available actions and the case-study panel only if
 * the project actually has notes to show.
 *
 * Why the build notes are inline data instead of MDX or separate files:
 * the cards are short, the notes are short, and the editing flow is
 * "open one file and tweak strings", which is exactly what we want for content
 * that changes whenever I ship something new.
 */

interface BuildNotes {
  // Problem the project solves, framed as a real user pain. Avoid
  // "I wanted to learn X" framing. That's a tutorial, not a product.
  problem: string;
  // Approach: the architectural decision that made the project possible.
  // One sentence, naming the lever. ("Run pandas in WebAssembly.")
  approach: string;
  // Architecture: optional one-line system sketch. Used on Live cards
  // to show I think in pipelines, not just scripts.
  architecture?: string;
  // Why it matters: the business or user impact in plain language.
  why?: string;
}

interface Project {
  title: string;
  blurb: string;
  stack: string[];
  link?: string;
  repo?: string;
  // The "result" line is a single concrete outcome. Specific numbers or
  // tangible wins make a project read as real work rather than a tutorial.
  result?: string;
  status?: "Live" | "In development" | "Case study" | "Concept";
  // GitHub repo path ("IgorCSIS/niftystats") for the live stars badge.
  // Pulled separately so the badge link can use shields.io while the
  // Code button uses the full GitHub URL.
  ghRepo?: string;
  // Lead card flag. The first live project gets a flowing animated
  // border so the eye lands there first. Only one card should carry it
  // at a time, otherwise the effect becomes noise.
  isLead?: boolean;
  buildNotes?: BuildNotes;
}

// Three shipped products, all live, ordered by what does the most work
// for the hire-me pitch. The Prompt Library leads because it's the
// strongest single proof of the moat (prompt engineering since 2020)
// that runs through the rest of the site. Retail Lead Router moved to
// CurrentlyBuilding's "In development" column rather than living here
// as a permanent concept card, because a portfolio with three shipped
// items is a louder signal than one with two shipped + one promised.
const projects: Project[] = [
  {
    title: "MASTER Prompt Library",
    blurb:
      "427 career-grade prompts built on a 9-layer framework (Mission, Agent, Situation, Task, Examples, Rules, Think, Eval, Output). Templates, completed exercises against real situations, and a scheduled scraper that surfaces the best prompts from across the web.",
    stack: ["Next.js", "TypeScript", "GitHub Pages", "Scheduled scraper"],
    result: "Six years of prompt engineering, made browsable",
    status: "Live",
    link: "https://igorcsis.github.io/prompt-library/",
    // No public source link for now; the library itself is the artifact.
    isLead: true,
    buildNotes: {
      problem:
        "Most prompt libraries online are unsorted piles of clever-sounding strings. When a prompt fails, there's no framework to tell you which layer went wrong, and \"just rewrite it\" is not a methodology.",
      approach:
        "Every prompt is built on the MASTER framework so any failure traces to a specific missing layer. 427 prompts across 18 categories, each one audited. Two formats: Full MASTER (all 9 layers) and MASTER-lite for daily-use templates.",
      architecture: "Next.js static export → GitHub Pages, plus a scheduled scraper that scores and ingests prompts from across the web into the discovery feed.",
      why: "Backs up the \"prompt engineering since 2020\" claim with a clickable, browsable artifact. The framework itself is the deliverable that hiring managers and prospects actually want to see.",
    },
  },
  {
    title: "NiftyStats",
    blurb:
      "Browser-native statistical analysis. Drop in a CSV, get descriptives, distributions, and correlations rendered in the page. Pyodide runs the Python in WebAssembly so your data never leaves your machine.",
    stack: ["Vite", "React", "Pyodide", "Pandas"],
    result: "Zero-backend stats, full Python power",
    status: "Live",
    link: "https://igorcsis.github.io/niftystats/",
    repo: "https://github.com/IgorCSIS/niftystats",
    ghRepo: "IgorCSIS/niftystats",
    buildNotes: {
      problem:
        "Quick CSV analysis usually means uploading to a server you don't fully trust or wrestling with a local Python install. Neither is great when the data is sensitive.",
      approach:
        "Run pandas in the browser via Pyodide (Python compiled to WebAssembly). The CSV never leaves the device, but the full pandas API is available.",
      architecture: "Vite + React UI → Pyodide worker → pandas, NumPy, SciPy in WebAssembly",
      why: "Sensitive data stays local. No backend means zero hosting cost. The whole site is a static bundle on GitHub Pages.",
    },
  },
  {
    title: "NiftyVid",
    blurb:
      "Image-to-video AI generator in the browser. Drop a photo, write a short motion prompt, get a 5-second MP4 back. Built on Wan 2.2, the open-source answer to Runway Gen-3 and Kling.",
    stack: ["Astro", "Tailwind", "Cloudflare Workers", "Wan 2.2"],
    result: "Free AI video, fully in the browser",
    status: "Live",
    link: "https://igorcsis.github.io/nifty-vid/",
    repo: "https://github.com/IgorCSIS/nifty-vid",
    ghRepo: "IgorCSIS/nifty-vid",
    buildNotes: {
      problem:
        "Image-to-video AI is locked behind paid platforms (Runway, Kling, Pika). Hobbyists and small teams who want to try it hit paywalls or limited free tiers.",
      approach:
        "Proxy a public Hugging Face Space running Wan 2.2 through a Cloudflare Worker. Static frontend on GitHub Pages calls the Worker, never the Space directly.",
      architecture: "Astro static site → Cloudflare Worker (CORS + URL stability) → HF Space (Wan 2.2 on shared GPU)",
      why: "Worker abstraction means swapping inference providers (fal.ai, Replicate, private Space) doesn't touch the frontend.",
    },
  },
];

// Status pill colors. Keeping the mapping inline avoids the temptation
// to overbuild a theming system for three labels.
const statusStyles: Record<NonNullable<Project["status"]>, string> = {
  Live: "border-electric-500/40 bg-electric-500/10 text-electric-400",
  "In development": "border-amber-500/40 bg-amber-500/10 text-amber-400",
  "Case study": "border-paper-300/30 bg-ink-700 text-paper-200",
  Concept: "border-paper-300/30 bg-ink-700 text-paper-200",
};

// Shields.io badge URL builder. Returns a static SVG that shields.io
// renders server-side with live data from the GitHub API. The styling
// args (color, label color, style=flat-square) keep the badge from
// looking like the default green-on-grey GitHub default and match our
// palette. The badge is wrapped in a link to the repo's stargazers page
// so a click goes somewhere useful.
const starBadge = (repo: string): string =>
  `https://img.shields.io/github/stars/${repo}?style=flat-square&color=3ee0bb&labelColor=0f1115&logo=github&logoColor=8b909f&label=stars`;
---

<section id="portfolio" class="relative py-16 md:py-24">
  <!-- A subtle horizontal gradient separator above the section. Just a
       hairline that fades in and out, no JS, no images. -->
  <div
    class="mx-auto mb-20 h-px max-w-6xl bg-gradient-to-r from-transparent via-electric-500/30 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <span class="reveal section-label">Selected work</span>
        <h2
          class="reveal display-h2 mt-4 text-4xl font-bold md:text-5xl"
          data-reveal-delay="100"
        >
          Shipped, and more on the way.
        </h2>
        <p class="reveal mt-5 text-lg text-paper-200" data-reveal-delay="200">
          Three live products you can try right now, more on the way. Want
          something like these built for your business? That's the offer.
        </p>
      </div>

      <a
        href="https://github.com/IgorCSIS"
        target="_blank"
        rel="noopener noreferrer"
        class="reveal inline-flex items-center gap-2 text-sm font-semibold text-electric-400 transition-all hover:gap-3"
        data-reveal-delay="300"
      >
        Everything on GitHub
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, i) => (
          <article
            class:list={[
              "reveal card-hover group relative flex flex-col overflow-hidden rounded-2xl border border-ink-600 bg-ink-800/40 p-6",
              project.isLead && "border-flow",
            ]}
            data-reveal-delay={i * 100}
          >
            {/* Decorative project number watermark. Adds visual rhythm to
                the grid without needing project screenshots yet. */}
            <span
              class="pointer-events-none absolute right-3 top-2 select-none font-display text-6xl font-bold leading-none text-ink-700"
              aria-hidden="true"
            >
              0{i + 1}
            </span>

            <div class="relative z-10 flex items-center gap-2">
              {project.status && (
                <span
                  class={`inline-flex w-fit items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-xs ${statusStyles[project.status]}`}
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-current" />
                  {project.status}
                </span>
              )}
              {/* GitHub stars badge for projects with a real repo. The
                  image is rendered by shields.io with live data from
                  GitHub's API, so the star count updates on every
                  cache refresh without us needing to fetch it ourselves. */}
              {project.ghRepo && (
                <a
                  href={`https://github.com/${project.ghRepo}/stargazers`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ml-auto opacity-70 transition-opacity hover:opacity-100"
                  aria-label={`Star ${project.title} on GitHub`}
                >
                  <img
                    src={starBadge(project.ghRepo)}
                    alt={`${project.title} GitHub stars`}
                    height="20"
                    loading="lazy"
                  />
                </a>
              )}
            </div>

            <h3 class="relative z-10 mt-5 font-display text-xl font-semibold text-paper-100">
              {project.title}
            </h3>
            <p class="relative z-10 mt-2 text-sm text-paper-200">{project.blurb}</p>

            {project.result && (
              <div class="relative z-10 mt-5 rounded-lg border border-ink-600 bg-ink-900/60 px-3 py-2 font-mono text-xs text-electric-400">
                {`> ${project.result}`}
              </div>
            )}

            <ul class="relative z-10 mt-5 flex flex-wrap gap-1.5">
              {project.stack.map((tech) => (
                <li class="rounded-md bg-ink-700/60 px-2 py-1 font-mono text-[11px] text-paper-200">
                  {tech}
                </li>
              ))}
            </ul>

            {/* Case-study spine. <details> is native browser collapsible
                content (accessible, no JS, keyboard-friendly). The
                summary line is the "Read the build notes" affordance.
                Inside: Problem, Approach, (optional Architecture), Why.
                This is the audit's "case study energy" point, done
                without forcing every visitor to read four paragraphs. */}
            {project.buildNotes && (
              <details class="relative z-10 mt-5 group/notes">
                <summary class="flex cursor-pointer list-none items-center gap-2 font-mono text-xs uppercase tracking-wider text-paper-300 transition-colors hover:text-electric-400">
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform group-open/notes:rotate-90"
                    aria-hidden="true"
                  >
                    <path d="M9 18l6-6-6-6" />
                  </svg>
                  Build notes
                </summary>
                <div class="mt-4 space-y-3 border-l border-ink-600 pl-4 text-sm">
                  <div>
                    <div class="font-mono text-[10px] uppercase tracking-wider text-electric-400">
                      Problem
                    </div>
                    <p class="mt-1 text-paper-200">{project.buildNotes.problem}</p>
                  </div>
                  <div>
                    <div class="font-mono text-[10px] uppercase tracking-wider text-electric-400">
                      Approach
                    </div>
                    <p class="mt-1 text-paper-200">{project.buildNotes.approach}</p>
                  </div>
                  {project.buildNotes.architecture && (
                    <div>
                      <div class="font-mono text-[10px] uppercase tracking-wider text-electric-400">
                        Architecture
                      </div>
                      <p class="mt-1 font-mono text-xs text-paper-200">
                        {project.buildNotes.architecture}
                      </p>
                    </div>
                  )}
                  {project.buildNotes.why && (
                    <div>
                      <div class="font-mono text-[10px] uppercase tracking-wider text-electric-400">
                        Why it matters
                      </div>
                      <p class="mt-1 text-paper-200">{project.buildNotes.why}</p>
                    </div>
                  )}
                </div>
              </details>
            )}

            <div class="relative z-10 mt-6 flex items-center gap-4 text-sm">
              {project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-magnetic inline-flex items-center gap-1 font-semibold text-electric-400 transition-colors hover:text-electric-500"
                >
                  Visit
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M9 7h8v8" />
                  </svg>
                </a>
              )}
              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-magnetic inline-flex items-center gap-1 font-semibold text-paper-200 transition-colors hover:text-paper-100"
                >
                  Code
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M16 18l6-6-6-6M8 6l-6 6 6 6" />
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
