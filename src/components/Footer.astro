---
/**
 * Footer.
 *
 * Confirms who this is, repeats the one CTA, and gives the two off-site
 * links. No mailto anywhere: every contact path runs through the form so
 * there is nothing for a scraper to harvest.
 */
import { site, nav } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="relative z-10 mt-8 border-t border-navy-700 bg-navy-950/50">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-16">
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-5">
        <a href="#top" class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight text-mist-50">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="text-cyan-400">
            <circle cx="4.5" cy="4.5" r="2.5" fill="currentColor" />
            <circle cx="15.5" cy="15.5" r="2.5" fill="currentColor" opacity="0.5" />
            <path
              d="M4.5 7v5.5A3 3 0 0 0 7.5 15.5H13"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
          {site.name}
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-mist-300">
          Python automation, data pipelines, and internal tools for businesses in
          {site.city}, {site.metro}, and anywhere else that works over a call.
        </p>
      </div>

      <nav class="md:col-span-3" aria-label="Footer">
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-mist-300">Sections</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-mist-200 transition-colors hover:text-cyan-300">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:col-span-4">
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-mist-300">Start here</p>
        <a href="#contact" class="btn btn-primary mt-4 w-full sm:w-auto">Book the $500 audit</a>
        <div class="mt-5 flex gap-4 text-sm">
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline"
          >
            LinkedIn
          </a>
          <a href={site.github} target="_blank" rel="noopener noreferrer" class="link-underline">
            GitHub
          </a>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-navy-700 pt-6 text-xs text-mist-300 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}. {site.studio} studio.</p>
      <p class="font-mono">Astro and Tailwind, static, on GitHub Pages.</p>
    </div>
  </div>
</footer>
