---
/**
 * Site footer.
 *
 * Three jobs: confirm the brand once more, give people a non-form way to
 * reach me (mailto + socials), and stamp the copyright/build year. The
 * year is computed at build time, not hardcoded, so the site doesn't
 * silently become last-year's when January 1 ticks over.
 */

const currentYear = new Date().getFullYear();

// Social links pulled into an array so it's a one-line edit to add a new
// platform later. Each entry has a label (visible + a11y), an href, and
// an inline SVG path so we don't depend on an icon library for four icons.
const socials = [
  {
    label: "GitHub",
    href: "https://github.com/IgorCSIS",
    path: "M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.1c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .98-.31 3.2 1.18a11.1 11.1 0 0 1 5.82 0c2.22-1.49 3.2-1.18 3.2-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.05.78 2.12v3.14c0 .3.21.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/",
    path: "M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.89 1.63-1.85 3.36-1.85 3.59 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.99 0 1.78-.77 1.78-1.72V1.72C24 .77 23.21 0 22.22 0z",
  },
  {
    label: "Email",
    href: "mailto:hello@niftyai.dev",
    path: "M1.5 4.5h21c.83 0 1.5.67 1.5 1.5v12c0 .83-.67 1.5-1.5 1.5h-21A1.5 1.5 0 0 1 0 18V6c0-.83.67-1.5 1.5-1.5zm10.5 8.25 9.4-5.4H2.6L12 12.75zM2 8.4V18h20V8.4l-10 5.75L2 8.4z",
  },
];
---

<footer class="relative z-10 mt-32 border-t border-ink-700/60 bg-ink-900/80">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-2 md:items-end">
      <div>
        <a href="#top" class="flex items-center gap-2 font-display text-xl font-semibold">
          <span class="inline-block h-2 w-2 rounded-full bg-electric-500" aria-hidden="true"></span>
          <span class="text-paper-100">
            Nifty<span class="text-electric-500">Ai</span>
          </span>
        </a>
        <p class="mt-3 max-w-md text-sm text-paper-300">
          AI agents, automations, and clean web tools. Built one project at a
          time by Igor Lima from Brazil.
        </p>
      </div>

      <ul class="flex items-center gap-3 md:justify-end">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.href.startsWith("http") ? "_blank" : undefined}
                rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}
                aria-label={social.label}
                class="group inline-flex h-10 w-10 items-center justify-center rounded-full border border-ink-600 bg-ink-800 text-paper-200 transition-all duration-300 hover:border-electric-500 hover:text-electric-400 hover:-translate-y-0.5"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={social.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-ink-700/60 pt-6 text-xs text-paper-300 sm:flex-row sm:items-center"
    >
      <p>&copy; {currentYear} Igor Lima. All rights reserved.</p>
      <p class="font-mono">
        Built with Astro and Tailwind, deployed on GitHub Pages.
      </p>
    </div>
  </div>
</footer>
