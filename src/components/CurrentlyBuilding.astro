---
/**
 * Currently Building section.
 *
 * The "Now" section pattern, borrowed from Derek Sivers and adapted for a
 * builder-portfolio context. Three columns: shipped, in development,
 * exploring. The aim is to make the site feel alive without forcing the
 * portfolio cards to do double duty as a status board.
 *
 * Why this matters for hire-me positioning:
 * Recruiters and prospects skim portfolios. A "Currently Building" block
 * signals momentum (this person ships continuously) and currency (the
 * stack is up to date with what's actually being built in 2026, not
 * what was hot in 2023). Both of those are hard to fake.
 *
 * Editing this is meant to be cheap: change the arrays below, push.
 * Whenever something flips from "in development" to "shipped," move it
 * up a column and consider whether it deserves a slot in Portfolio too.
 */

// Shipped: live, public, working. Same set as the Portfolio cards but
// distilled to one line each so this section reads as a status board
// instead of a duplicate listing.
const shipped = [
  {
    name: "MASTER Prompt Library",
    note: "427 prompts on a 9-layer framework, plus a scraped feed",
    link: "https://igorcsis.github.io/prompt-library/",
  },
  {
    name: "NiftyStats",
    note: "Browser-native CSV stats via Pyodide",
    link: "https://igorcsis.github.io/niftystats/",
  },
  {
    name: "NiftyVid",
    note: "Image-to-video with Wan 2.2, free in the browser",
    link: "https://igorcsis.github.io/nifty-vid/",
  },
];

// In progress: real codebases that exist but aren't public-ready yet.
// Be honest here, empty promises age badly. Better to list one real
// thing than three aspirational ones.
const inProgress = [
  {
    name: "Retail Lead Router",
    note: "Intent classification + reply drafting for inbound store leads",
  },
  {
    name: "NiftyVid v2",
    note: "Streaming progress UI, last-frame guidance, longer outputs",
  },
];

// Exploring: things I'm actively learning or testing. Lower commitment
// than "in progress" but higher signal than "interested in." This is
// where the audit's "currently learning" energy lives.
const exploring = [
  "Agentic UX patterns (long-running tasks, interruption, recovery)",
  "Multimodal pipelines (image + text + audio in one prompt graph)",
  "Local-first AI (Pyodide, WebGPU, ONNX in the browser)",
  "Memory architectures for stateful agents",
];

// Column definitions. Pulling these into an array means the template
// stays simple and adding a fourth column later (or reordering) is a
// one-line edit, not a JSX rewrite.
const columns = [
  {
    label: "Shipped",
    accent: "text-electric-400",
    dot: "bg-electric-500",
    items: shipped,
  },
  {
    label: "In development",
    accent: "text-amber-400",
    dot: "bg-amber-500",
    items: inProgress,
  },
];
---

<!-- The section anchor "now" matches the convention of /now pages
     across builder portfolios, so future links from elsewhere will hit
     this block directly. -->
<section id="now" class="relative py-16 md:py-24">
  <!-- Faint hairline divider at the top, same pattern as Portfolio. -->
  <div
    class="mx-auto mb-20 h-px max-w-6xl bg-gradient-to-r from-transparent via-electric-500/30 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <span class="reveal section-label">Currently building</span>
        <h2
          class="reveal display-h2 mt-4 text-4xl font-bold md:text-5xl"
          data-reveal-delay="100"
        >
          A live snapshot of what's on my workbench.
        </h2>
        <p class="reveal mt-5 text-lg text-paper-200" data-reveal-delay="200">
          Updated whenever something ships or moves. If you're hiring me,
          this is what active looks like.
        </p>
      </div>

      {/* Last-updated stamp. Computed at build time so it stays honest:
          if I push, the date refreshes. If I haven't shipped in a month,
          this date will tell on me, which is the point. */}
      <div class="reveal font-mono text-xs text-paper-300" data-reveal-delay="300">
        <span class="text-electric-400">last build:</span>{" "}
        {new Date().toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
      </div>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {/* Two structured columns (shipped, in development) rendered from
          the columns array, plus a third "Exploring" column rendered
          inline because its items are plain strings, not objects. */}
      {
        columns.map((column, ci) => (
          <article
            class="reveal rounded-2xl border border-ink-600 bg-ink-800/40 p-6"
            data-reveal-delay={ci * 120}
          >
            <header class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider">
              <span class={`inline-block h-2 w-2 rounded-full ${column.dot}`} aria-hidden="true" />
              <span class={column.accent}>{column.label}</span>
              <span class="ml-auto text-paper-300">{column.items.length.toString().padStart(2, "0")}</span>
            </header>

            <ul class="mt-5 space-y-4">
              {column.items.map((item) => (
                <li>
                  {/* "link" in item is a TS-friendly runtime check: it
                      narrows the union so item.link is typed as string
                      inside the truthy branch. Cleaner than threading
                      a discriminator through the data. */}
                  {"link" in item ? (
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group/item block"
                    >
                      <div class="flex items-center gap-2 font-display text-base font-semibold text-paper-100 transition-colors group-hover/item:text-electric-400">
                        {item.name}
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M7 17L17 7M9 7h8v8" />
                        </svg>
                      </div>
                      <p class="mt-1 text-sm text-paper-300">{item.note}</p>
                    </a>
                  ) : (
                    <div>
                      <div class="font-display text-base font-semibold text-paper-100">
                        {item.name}
                      </div>
                      <p class="mt-1 text-sm text-paper-300">{item.note}</p>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </article>
        ))
      }

      {/* Exploring column. Plain strings, no links, slightly different
          visual rhythm (bulleted list rather than name + note pairs)
          to signal these are open threads, not committed work. */}
      <article
        class="reveal rounded-2xl border border-ink-600 bg-ink-800/40 p-6"
        data-reveal-delay={240}
      >
        <header class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider">
          <span class="inline-block h-2 w-2 rounded-full bg-paper-300" aria-hidden="true" />
          <span class="text-paper-200">Exploring</span>
          <span class="ml-auto text-paper-300">
            {exploring.length.toString().padStart(2, "0")}
          </span>
        </header>

        <ul class="mt-5 space-y-3">
          {
            exploring.map((item) => (
              <li class="flex items-start gap-3 text-sm text-paper-200">
                <span class="mt-1.5 inline-block h-1 w-1 flex-shrink-0 rounded-full bg-electric-500" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</section>
