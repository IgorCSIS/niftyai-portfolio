---
/**
 * About.
 *
 * Two columns: the story on the left, hard facts and the stack on the
 * right. The operator background is the actual differentiator here, so it
 * leads. Everything in the facts list is verifiable.
 */
import { about } from "../data/site";
---

<section id="about" class="relative py-section lg:py-section-lg">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="reveal label">{about.label}</p>
        <h2 class="reveal t-h2 mt-5 text-mist-50" data-reveal-delay="60">{about.title}</h2>

        <div class="mt-7 space-y-5">
          {
            about.paragraphs.map((paragraph, i) => (
              <p class="reveal text-[1.02rem] leading-relaxed text-mist-200" data-reveal-delay={90 + i * 70}>
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-5 lg:pt-14">
        <dl class="reveal surface divide-y divide-navy-700 p-1" data-reveal-delay="120">
          {
            about.facts.map((fact) => (
              <div class="flex items-baseline justify-between gap-6 px-5 py-4">
                <dt class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-mist-300">
                  {fact.k}
                </dt>
                <dd class="text-right text-sm font-medium text-mist-50">{fact.v}</dd>
              </div>
            ))
          }
        </dl>

        <div class="reveal mt-8" data-reveal-delay="200">
          <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-mist-300">
            What I build with
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              about.stack.map((item) => (
                <li class="rounded-md border border-navy-600 bg-navy-950/60 px-2.5 py-1.5 font-mono text-[0.7rem] text-mist-200">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
