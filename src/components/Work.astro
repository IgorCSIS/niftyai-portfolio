---
/**
 * Selected work.
 *
 * Each project is a Problem / Build / Result triplet with live links.
 * There are no client names or revenue figures here because there are no
 * real ones to publish yet; the results are stated qualitatively and the
 * links let people check the claim themselves, which is stronger than a
 * number nobody can verify.
 *
 * The first project gets the wide two-column treatment; the second uses
 * the same card at a quieter weight. Smaller side projects are a list,
 * not cards, so they read as context rather than as proof.
 */
import { work } from "../data/site";

// Rendered in order for both projects; keeping the labels in one array
// means the three blocks stay visually identical between cards.
const blocks = [
  { key: "problem", label: "Problem" },
  { key: "build", label: "Build" },
  { key: "result", label: "Result" },
] as const;
---

<section id="work" class="relative py-section lg:py-section-lg">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="max-w-2xl">
      <p class="reveal label">{work.label}</p>
      <h2 class="reveal t-h2 mt-5 text-mist-50" data-reveal-delay="60">{work.title}</h2>
      <p class="reveal t-lead mt-5" data-reveal-delay="120">{work.intro}</p>
    </div>

    <div class="mt-12 space-y-4 lg:mt-16 lg:space-y-5">
      {
        work.projects.map((project, i) => (
          <article
            class:list={[
              "reveal surface surface-hover overflow-hidden p-7 sm:p-9 lg:p-10",
              project.featured && "lg:pb-11",
            ]}
            data-reveal-delay={i * 80}
          >
            <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
              <!-- Left rail: name, status, stack. -->
              <div class="lg:col-span-4">
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="font-display text-2xl font-semibold tracking-tight text-mist-50 sm:text-3xl">
                    {project.name}
                  </h3>
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-2.5 py-1 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-cyan-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-cyan-400" aria-hidden="true" />
                    {project.status}
                  </span>
                </div>

                <p class="mt-3 text-[0.95rem] text-mist-200">{project.tagline}</p>

                <ul class="mt-6 flex flex-wrap gap-2">
                  {project.stack.map((item) => (
                    <li class="rounded-md border border-navy-600 bg-navy-950/60 px-2.5 py-1 font-mono text-[0.65rem] text-mist-300">
                      {item}
                    </li>
                  ))}
                </ul>

                <div class="mt-7 flex flex-col gap-3 sm:flex-row lg:flex-col">
                  {project.links.map((link, li) => (
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                      class:list={[
                        "btn !min-h-0 !px-5 !py-2.5 text-sm",
                        li === 0 ? "btn-primary" : "btn-ghost",
                      ]}
                    >
                      {link.label}
                      {link.external && (
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M7 17 17 7M9 7h8v8" />
                        </svg>
                      )}
                    </a>
                  ))}
                </div>
              </div>

              <!-- Right: the actual case, three labelled blocks. -->
              <div class="lg:col-span-8">
                <dl class="space-y-6">
                  {blocks.map((block) => (
                    <div class="border-l border-navy-600 pl-5 sm:pl-6">
                      <dt class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-cyan-300">
                        {block.label}
                      </dt>
                      <dd class="mt-2 text-[0.97rem] leading-relaxed text-mist-200">
                        {project[block.key]}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Smaller projects. Listed plainly so they add texture without
         competing with the two that carry the pitch. -->
    <div class="reveal mt-10 flex flex-col gap-4 border-t border-navy-700 pt-8 sm:flex-row sm:items-start sm:gap-10">
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-mist-300 sm:w-32 sm:shrink-0 sm:pt-1">
        {work.also.title}
      </p>
      <ul class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-8">
        {
          work.also.items.map((item) => (
            <li class="text-sm text-mist-200">
              <span class="font-semibold text-mist-50">{item.name}</span>
              <span class="text-mist-300"> · {item.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
