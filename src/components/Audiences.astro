---
/**
 * Who it is for.
 *
 * Four audience cards. The job of this section is recognition: a
 * contractor should read the first card and think "that is my Tuesday".
 * Each card names the work, not the technology.
 *
 * Cards stagger their reveal by index so the row develops left to right
 * instead of all four landing at once.
 */
import { audiences } from "../data/site";
---

<section id="who-its-for" class="relative py-section lg:py-section-lg">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="max-w-2xl">
      <p class="reveal label">{audiences.label}</p>
      <h2 class="reveal t-h2 mt-5 text-mist-50" data-reveal-delay="60">
        {audiences.title}
      </h2>
      <p class="reveal t-lead mt-5" data-reveal-delay="120">{audiences.intro}</p>
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14">
      {
        audiences.cards.map((card, i) => (
          <li
            class="reveal surface surface-hover flex flex-col p-6 sm:p-7"
            data-reveal-delay={80 * i}
          >
            <h3 class="t-h3 text-mist-50">{card.name}</h3>
            <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-mist-200">{card.body}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {card.tags.map((tag) => (
                <li class="rounded-full border border-navy-600 bg-navy-950/60 px-3 py-1 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-mist-300">
                  {tag}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
