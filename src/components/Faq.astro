---
/**
 * FAQ.
 *
 * Built on native <details>/<summary> so every question still opens with
 * JavaScript disabled and screen readers get the disclosure semantics for
 * free. The only scripted behavior anywhere near this is the plus icon
 * rotation, which is pure CSS driven by the [open] attribute.
 *
 * These are real objections, in the order people actually raise them.
 */
import { faq } from "../data/site";
---

<section id="faq" class="relative py-section lg:py-section-lg">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="reveal label">{faq.label}</p>
        <h2 class="reveal t-h2 mt-5 text-mist-50" data-reveal-delay="60">{faq.title}</h2>
        <p class="reveal mt-5 text-mist-300" data-reveal-delay="120">
          Anything not covered here, put it in the form below and I will answer it
          straight.
        </p>
      </div>

      <div class="lg:col-span-8">
        <ul class="border-t border-navy-700">
          {
            faq.items.map((item, i) => (
              <li class="reveal border-b border-navy-700" data-reveal-delay={i * 50}>
                <details class="faq-item group">
                  <summary class="flex items-start justify-between gap-6 py-5 text-left">
                    <span class="t-h3 text-mist-50 transition-colors group-hover:text-cyan-300">
                      {item.q}
                    </span>
                    <span
                      class="faq-icon mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-navy-600 text-cyan-300"
                      aria-hidden="true"
                    >
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
                        <path d="M12 5v14M5 12h14" />
                      </svg>
                    </span>
                  </summary>
                  <p class="max-w-2xl pb-6 pr-10 text-[0.97rem] leading-relaxed text-mist-200">
                    {item.a}
                  </p>
                </details>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
