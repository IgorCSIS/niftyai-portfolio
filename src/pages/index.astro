---
/**
 * Home page.
 *
 * One long landing page, eight sections, anchors in the nav. The order
 * follows the questions a stranger asks in sequence:
 *
 *   Hero          what is this and what do I do next
 *   TrustStrip    where are you and can I work with you
 *   Audiences     is this for a business like mine
 *   Process       what does it cost and what do I get
 *   Work          have you actually built anything
 *   About         who am I dealing with
 *   Faq           the objections that stop the booking
 *   Contact       the booking
 *
 * All copy lives in src/data/site.ts. These components are renderers, so
 * editing the page is editing that one file.
 */
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import TrustStrip from "@components/TrustStrip.astro";
import Audiences from "@components/Audiences.astro";
import Process from "@components/Process.astro";
import Work from "@components/Work.astro";
import About from "@components/About.astro";
import Faq from "@components/Faq.astro";
import Contact from "@components/Contact.astro";
---

<Layout>
  <Hero />
  <TrustStrip />
  <Audiences />
  <Process />
  <Work />
  <About />
  <Faq />
  <Contact />
</Layout>
