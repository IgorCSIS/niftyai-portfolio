---
/**
 * Home page.
 *
 * The site is single-page for v1: one long scroll, four sections, anchor
 * links in the nav. This works well for portfolios because the whole
 * pitch lives in one URL you can paste anywhere. If the content outgrows
 * this format, we split into /services, /work, /about routes later.
 */
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import About from "@components/About.astro";
import Services from "@components/Services.astro";
import Portfolio from "@components/Portfolio.astro";
import CurrentlyBuilding from "@components/CurrentlyBuilding.astro";
import Contact from "@components/Contact.astro";
---

<!-- Order matters for the read.
     Hero: punch the positioning in 5 seconds.
     Services: what I sell, with prices, no hide-and-seek.
     Portfolio: proof I ship.
     CurrentlyBuilding: proof I'm still shipping (vs. portfolio frozen in time).
     About: the human story for visitors who scrolled this far.
     Contact: the conversion.
     The audit's "reduce cognitive load" point applies here: each section
     is doing one job, and the order maps to the buyer's question funnel. -->
<Layout>
  <Hero />
  <Services />
  <Portfolio />
  <CurrentlyBuilding />
  <About />
  <Contact />
</Layout>
