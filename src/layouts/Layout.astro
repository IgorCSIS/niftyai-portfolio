---
/**
 * Document shell for every page.
 *
 * Owns <head>, the sticky nav, the footer, and the two small client
 * scripts. Page content goes through the default slot.
 *
 * SEO posture:
 *  - Title leads with the name and the service plus both city names, since
 *    "python automation el cajon" and "python automation san diego" are
 *    two different searches and the second is the bigger one.
 *  - Description stays under 160 characters so Google shows it whole.
 *  - JSON-LD describes a Person and a ProfessionalService. Prices in the
 *    schema come from src/data/site.ts, so the structured data cannot
 *    drift away from what the page actually says.
 */
import "../styles/global.css";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";
import MobileCta from "@components/MobileCta.astro";
import { site, meta } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = meta.title, description = meta.description, image } = Astro.props;

/**
 * Join the GitHub Pages base path onto a site-relative asset path.
 * BASE_URL is "/niftyai-portfolio/" in production and "/" in dev, so the
 * naive template-literal version produces a double slash in one of them.
 */
function withBase(path: string): string {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  return `${base}/${path.replace(/^\//, "")}`;
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(image ?? withBase("images/og-image.png"), Astro.site).href;

const personSchema = {
  "@type": "Person",
  "@id": `${canonicalUrl}#person`,
  name: site.name,
  url: canonicalUrl,
  image: ogImageUrl,
  jobTitle: "Python Automation Developer",
  knowsLanguage: ["en", "pt", "es"],
  knowsAbout: [
    "Python",
    "Business Process Automation",
    "Data Pipelines",
    "Internal Tools",
    "Large Language Model APIs",
    "TypeScript",
    "React",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  sameAs: [site.linkedin, site.github],
};

const businessSchema = {
  "@type": "ProfessionalService",
  "@id": `${canonicalUrl}#business`,
  name: `${site.name} (${site.studio})`,
  url: canonicalUrl,
  image: ogImageUrl,
  description: meta.description,
  priceRange: "$$",
  founder: { "@id": `${canonicalUrl}#person` },
  address: {
    "@type": "PostalAddress",
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  areaServed: [
    { "@type": "Place", name: site.serviceArea },
    { "@type": "AdministrativeArea", name: site.region },
    { "@type": "Country", name: "United States" },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Automation services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Automation audit",
          description:
            "One week review of repetitive workflows with a ranked, fixed-price automation plan.",
        },
        priceSpecification: {
          "@type": "PriceSpecification",
          price: "500",
          priceCurrency: "USD",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Automation build",
          description:
            "Fixed-scope Python automation, data pipeline, or internal tool, delivered in two to four weeks.",
        },
        priceSpecification: {
          "@type": "PriceSpecification",
          minPrice: "2000",
          maxPrice: "5000",
          priceCurrency: "USD",
        },
      },
    ],
  },
  availableLanguage: [
    { "@type": "Language", name: "English", alternateName: "en" },
    { "@type": "Language", name: "Portuguese", alternateName: "pt" },
    { "@type": "Language", name: "Spanish", alternateName: "es" },
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "Sales",
    // Points at the form anchor rather than exposing a scrapable address.
    url: `${canonicalUrl}#contact`,
    availableLanguage: ["English", "Portuguese", "Spanish"],
    areaServed: ["US"],
  },
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [personSchema, businessSchema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B1220" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={meta.keywords.join(", ")} />
    <meta name="author" content={site.name} />

    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />

    <!-- Geo tags. Bing still reads these and they cost nothing. The pin is
         the El Cajon city center, not a street address. -->
    <meta name="geo.region" content={site.regionCode} />
    <meta name="geo.placename" content={`${site.city}, ${site.region}`} />
    <meta name="geo.position" content="32.7948;-116.9625" />
    <meta name="ICBM" content="32.7948, -116.9625" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.name}: Python automation for businesses in El Cajon and San Diego`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />

    <!-- Fonts: Inter Tight for display, Inter for body, JetBrains Mono for
         the small uppercase labels. Weights are pinned to the four we
         actually use so the request stays small. display=swap means text
         paints in the fallback immediately. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <!-- Reveals start hidden in CSS so nothing flashes before the observer
         runs. With scripting off that observer never runs, which would
         leave the whole page invisible, so undo the hidden state here. -->
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
        }
      </style>
    </noscript>
  </head>

  <body class="relative antialiased">
    <a
      href="#main"
      class="sr-only rounded-full focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-cyan-400 focus:px-5 focus:py-3 focus:font-semibold focus:text-navy-900"
    >
      Skip to content
    </a>

    <Nav />

    <main id="main" class="relative z-10">
      <slot />
    </main>

    <Footer />
    <MobileCta />

    <script>
      import { initReveal } from "../scripts/reveal";
      import { initNav } from "../scripts/nav";
      import { initContactForm } from "../scripts/form";

      initReveal();
      initNav();
      initContactForm();
    </script>
  </body>
</html>
